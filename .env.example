# --- Supabase (Project Settings → API) ---
SUPABASE_URL=https://xxxxxxxx.supabase.co
# Clave secreta / service_role. Sólo la usa el servidor; nunca llega al navegador.
# (La clave "publishable"/anon no sirve: el esquema le niega todo acceso a propósito.)
SUPABASE_SERVICE_ROLE_KEY=

# --- Acceso ---
# Obligatoria en producción: si falta, la app responde 503. En local puede quedar vacía.
# Usa una contraseña larga; cambiarla cierra todas las sesiones.
APP_PASSWORD=

# Novelas protegidas (docs/privacidad.md): secreto del servidor que se mezcla con cada PIN antes
# del hash, para que una copia de la base de datos no baste para probar PINs.
# Obligatoria en producción para proteger novelas. Genera una con: openssl rand -base64 32
# Si se pierde, los PIN dejan de comprobarse: se recuperan con «Olvidé el PIN» (APP_PASSWORD).
NOVEL_LOCK_PEPPER=

# --- IA: configura al menos un proveedor ---
# Proveedor que aparece seleccionado al empezar: anthropic | openai | xai
AI_PROVIDER=anthropic

ANTHROPIC_API_KEY=
ANTHROPIC_MODEL=claude-opus-5-5
# low | medium | high | xhigh | max  (más alto = más profundo, más lento y caro)
ANTHROPIC_EFFORT=medium

OPENAI_API_KEY=
# Comprueba el nombre de modelo vigente en platform.openai.com
OPENAI_MODEL=gpt-5.5

XAI_API_KEY=
# Comprueba el nombre de modelo vigente en console.x.ai
XAI_MODEL=grok-4

# Opcional, sólo para pruebas locales contra servidores simulados:
# ANTHROPIC_BASE_URL=  OPENAI_BASE_URL=  XAI_BASE_URL=
