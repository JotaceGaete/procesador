# --- Supabase (Project Settings → API) ---
SUPABASE_URL=https://xxxxxxxx.supabase.co
# Clave secreta / service_role. Solo se usa en el servidor, nunca llega al navegador.
SUPABASE_SERVICE_ROLE_KEY=

# --- IA ---
# Proveedor por defecto: "anthropic" o "xai" (Grok). Se puede cambiar desde la UI.
AI_PROVIDER=anthropic

ANTHROPIC_API_KEY=
ANTHROPIC_MODEL=claude-opus-5-5
# low | medium | high | xhigh | max  (más alto = más profundo, más lento y caro)
ANTHROPIC_EFFORT=medium

# Opcional: Grok vía API de xAI. Comprueba el nombre de modelo vigente en console.x.ai
XAI_API_KEY=
XAI_MODEL=grok-4

# --- Acceso ---
# Contraseña para entrar a la app. Obligatoria en producción: si falta, la app responde 503.
# En local (npm run dev) puede quedar vacía. Usa una contraseña larga; cambiarla cierra todas las sesiones.
APP_PASSWORD=
