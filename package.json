{
  "name": "procesador",
  "version": "0.1.0",
  "private": true,
  "scripts": {
    "icons": "node scripts/icons.mjs",
    "visual:report": "node --import tsx scripts/visual-roundtrip.ts",
    "dev": "next dev",
    "build": "next build",
    "start": "next start",
    "typecheck": "tsc --noEmit",
    "test": "node --import tsx --conditions=react-server --test \"tests/unit/*.test.ts\"",
    "test:e2e": "node tests/e2e/run.mjs",
    "test:all": "npm test && npm run test:schema && npm run test:e2e",
    "test:schema": "node --test --test-concurrency=1 tests/schema/run.mjs"
  },
  "dependencies": {
    "@anthropic-ai/sdk": "^0.131.0",
    "@supabase/supabase-js": "^2.117.2",
    "next": "^16.3.8",
    "openai": "^7.27.0",
    "prosemirror-commands": "^1.7.2",
    "prosemirror-gapcursor": "^1.4.1",
    "prosemirror-history": "^1.5.1",
    "prosemirror-keymap": "^1.2.3",
    "prosemirror-model": "^1.25.12",
    "prosemirror-state": "^1.4.4",
    "prosemirror-transform": "^1.12.2",
    "prosemirror-view": "^1.42.6",
    "react": "^19.3.0",
    "react-dom": "^19.3.0",
    "react-markdown": "^10.1.0",
    "server-only": "^0.0.1"
  },
  "devDependencies": {
    "@types/node": "^26.6.4",
    "@types/react": "^19.3.0",
    "@types/react-dom": "^19.3.0",
    "playwright": "^1.56.1",
    "tsx": "^4.23.15",
    "typescript": "^7.0.2"
  }
}
